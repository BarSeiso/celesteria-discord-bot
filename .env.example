# ⚜ Celesteria Environment Configuration
# Copy this file to .env and insert your real Discord bot token.

# Discord Application Credentials
DISCORD_TOKEN=your_bot_token_here

# Bot Behaviour Settings
BOT_PREFIX=!c
BOT_ENV=development
BOT_VERSION=1.0.0
LOG_LEVEL=INFO

# Storage
DATABASE_PATH=data/celesteria.db

# Optional: Instant slash command registration for a specific test server
TEST_GUILD_ID=

